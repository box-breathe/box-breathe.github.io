---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BreathingBox } from '../../components/BreathingBox';
import GuideSection from '../../components/GuideSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getTranslations } from '../../i18n';

const lang = 'fr';
const t = getTranslations(lang);
---

<BaseLayout lang={lang}>
  <section class="w-full flex flex-col items-center justify-center pt-3 sm:pt-8 md:pt-10 pb-3 sm:pb-6 px-2 sm:px-4">
    <div class="text-center max-w-xl mx-auto mb-1.5 sm:mb-3">
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#03684A] dark:text-white">
        Respiration Carrée
      </h1>
      <p class="mt-1 text-xs sm:text-base text-slate-600 dark:text-slate-400 font-normal">
        Quatre temps égaux pour apaiser l'esprit et retrouver votre concentration.
      </p>
    </div>

    <BreathingBox client:load t={t.breathing} langCode={lang} />
  </section>

  <GuideSection t={t.guide} />
  <FaqSection t={t.faq} />
</BaseLayout>
