---
import { SUPPORTED_LANGUAGES, type LanguageCode } from '../i18n/languages';
import { getLocalizedPath, type TranslationKey } from '../i18n';

interface Props {
  currentLang: LanguageCode;
  t: TranslationKey['nav'];
}

const { currentLang, t } = Astro.props;
const currentLangInfo = SUPPORTED_LANGUAGES.find((l) => l.code === currentLang) || SUPPORTED_LANGUAGES[0];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/90 dark:bg-[#091512]/90 border-b border-[#E5F6F1] dark:border-[#1A3830] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href={getLocalizedPath(currentLang, '/')}
      class="group flex items-center gap-2 sm:gap-2.5 focus:outline-none"
      aria-label="BoxBreathe Home"
    >
      <div class="relative w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-tr from-[#03684A] via-[#15D59C] to-[#66E1BC] p-[2px] shadow-sm group-hover:shadow-glow-mint transition-all">
        <div class="w-full h-full bg-white dark:bg-[#091512] rounded-[10px] flex items-center justify-center">
          <!-- Animated geometric breathing square icon -->
          <div class="w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-sm bg-[#03684A] dark:bg-[#15D59C] group-hover:scale-110 transition-transform"></div>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-base sm:text-lg tracking-tight text-[#03684A] dark:text-white">
          {t.logo}
        </span>
        <span class="hidden sm:inline-block text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#66E1BC] border border-[#66E1BC]/40 dark:border-[#1A3830]">
          4-4-4-4
        </span>
      </div>
    </a>

    <!-- Navigation & Action Controls -->
    <div class="flex items-center gap-1.5 sm:gap-3">
      <!-- 7-Language Selector Dropdown -->
      <div class="relative" id="lang-dropdown-container">
        <button
          id="lang-menu-button"
          type="button"
          class="inline-flex items-center gap-1 sm:gap-1.5 px-2 py-1.5 sm:px-3 sm:py-2 rounded-xl text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 bg-[#E5F6F1]/70 dark:bg-[#10221D] hover:bg-[#E5F6F1] dark:hover:bg-[#1A3830] transition-colors focus:outline-none border border-[#66E1BC]/30 dark:border-[#1A3830]"
          aria-expanded="false"
          aria-haspopup="true"
          title={t.language}
        >
          <!-- Flag/Badge -->
          <span class="inline-flex items-center justify-center w-5 h-4 text-[10px] font-bold rounded bg-white dark:bg-[#1F3831] text-[#03684A] dark:text-[#66E1BC]">
            {currentLangInfo.badge}
          </span>
          <!-- Language label: strictly visible on desktop, collapsed on mobile/tablet -->
          <span class="hidden lg:inline">{currentLangInfo.nativeName}</span>
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-menu-list"
          class="hidden absolute right-0 mt-2 w-44 rounded-2xl glass-panel shadow-2xl py-1.5 z-50 border border-[#66E1BC]/40 dark:border-[#1A3830] focus:outline-none"
          role="menu"
          aria-orientation="vertical"
        >
          {SUPPORTED_LANGUAGES.map((lang) => {
            const isSelected = lang.code === currentLang;
            const targetUrl = getLocalizedPath(lang.code, currentPath);
            return (
              <a
                href={targetUrl}
                class={`flex items-center justify-between px-3.5 py-2 text-xs sm:text-sm transition-colors ${
                  isSelected
                    ? 'bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#15D59C] font-semibold'
                    : 'text-slate-700 dark:text-slate-200 hover:bg-[#E5F6F1]/50 dark:hover:bg-[#10221D]/60'
                }`}
                role="menuitem"
              >
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-5 h-4 text-[10px] font-bold rounded bg-slate-200/80 dark:bg-slate-700">
                    {lang.badge}
                  </span>
                  <span>{lang.nativeName}</span>
                </div>
                {isSelected && (
                  <svg class="w-4 h-4 text-[#03684A] dark:text-[#15D59C]" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Light / Dark Theme Switcher -->
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-xl text-slate-600 dark:text-slate-300 bg-[#E5F6F1]/70 dark:bg-[#10221D] hover:bg-[#E5F6F1] dark:hover:bg-[#1A3830] transition-colors focus:outline-none border border-[#66E1BC]/30 dark:border-[#1A3830]"
        title={t.themeLight}
        aria-label="Toggle Light/Dark Theme"
      >
        <svg id="theme-toggle-light-icon" class="hidden w-4 h-4 text-[#15D59C]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" />
        </svg>
        <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4 text-[#03684A]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
        </svg>
      </button>

      <!-- BuyMeACoffee Support CTA -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold text-amber-950 dark:text-amber-200 bg-amber-100 hover:bg-amber-200 dark:bg-amber-950/80 dark:hover:bg-amber-900 border border-amber-300/60 dark:border-amber-700/60 transition-all active:scale-95 shadow-sm"
        title="Support the Developer on Buy Me a Coffee"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 3H4a2 2 0 00-2 2v10a4 4 0 004 4h8a4 4 0 004-4v-1h2a3 3 0 003-3V6a3 3 0 00-3-3zm-2 7h-2V5h2a1 1 0 011 1v3a1 1 0 01-1 1zm-3 8a2 2 0 01-2 2H6a2 2 0 01-2-2v-1h11v1zM4 19h16v2H4z" />
        </svg>
        <span class="hidden md:inline">{t.support}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const langBtn = document.getElementById('lang-menu-button');
  const langList = document.getElementById('lang-menu-list');

  if (langBtn && langList) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langList.classList.contains('hidden');
      if (isHidden) {
        langList.classList.remove('hidden');
        langBtn.setAttribute('aria-expanded', 'true');
      } else {
        langList.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', () => {
      if (!langList.classList.contains('hidden')) {
        langList.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      themeToggleLightIcon?.classList.remove('hidden');
      themeToggleDarkIcon?.classList.add('hidden');
    } else {
      themeToggleLightIcon?.classList.add('hidden');
      themeToggleDarkIcon?.classList.remove('hidden');
    }
  }

  updateThemeUI();

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
    updateThemeUI();
  });
</script>
