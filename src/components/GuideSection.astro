---
import type { TranslationKey } from '../i18n';

interface Props {
  t: TranslationKey['guide'];
}

const { t } = Astro.props;
---

<section class="w-full max-w-4xl mx-auto px-3 sm:px-6 py-8 sm:py-16">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-14">
    <span class="inline-block text-[11px] uppercase tracking-widest font-bold px-3 py-1 rounded-full bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#66E1BC] border border-[#66E1BC]/40 dark:border-[#1A3830] mb-2 sm:mb-3">
      {t.badge}
    </span>
    <h2 class="text-xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#03684A] dark:text-white">
      {t.title}
    </h2>
    <p class="mt-2 text-xs sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
      {t.subtitle}
    </p>
  </div>

  <!-- Deep Dive: What is Box Breathing & Navy SEAL Protocol -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-8 sm:mb-12">
    <!-- Card 1: What is it -->
    <div class="p-5 sm:p-7 rounded-3xl glass-panel shadow-sm border border-[#66E1BC]/30 dark:border-[#1A3830] flex flex-col justify-between">
      <div>
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-[#E5F6F1] dark:bg-[#10221D] flex items-center justify-center text-[#03684A] dark:text-[#15D59C] mb-3 sm:mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="4" />
          </svg>
        </div>
        <h3 class="text-base sm:text-xl font-bold text-slate-800 dark:text-white mb-1.5 sm:mb-2">
          {t.whatIsHeading}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {t.whatIsText}
        </p>
      </div>
    </div>

    <!-- Card 2: Navy SEAL Tactical Usage -->
    <div class="p-5 sm:p-7 rounded-3xl glass-panel shadow-sm border border-[#66E1BC]/30 dark:border-[#1A3830] flex flex-col justify-between">
      <div>
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-[#E5F6F1] dark:bg-[#10221D] flex items-center justify-center text-[#03684A] dark:text-[#15D59C] mb-3 sm:mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-base sm:text-xl font-bold text-slate-800 dark:text-white mb-1.5 sm:mb-2">
          {t.sealUsageHeading}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {t.sealUsageText}
        </p>
      </div>
    </div>
  </div>

  <!-- 4 Step How-To Protocol -->
  <div class="mb-8 sm:mb-14">
    <h3 class="text-lg sm:text-2xl font-bold text-center text-[#03684A] dark:text-white mb-5 sm:mb-8">
      {t.stepsHeading}
    </h3>
    <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <!-- Step 1 -->
      <div id="step-1" class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#10221D] border border-[#66E1BC]/30 dark:border-[#1A3830] shadow-sm relative overflow-hidden">
        <div class="text-2xl sm:text-3xl font-extrabold text-[#E5F6F1] dark:text-[#1A3830] absolute top-2 right-3">01</div>
        <div class="relative z-10">
          <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded bg-[#E5F6F1] dark:bg-[#03684A]/60 text-[#03684A] dark:text-[#E5F6F1] mb-1.5">
            Phase 1
          </span>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-1">{t.step1Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.step1Desc}</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div id="step-2" class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#10221D] border border-[#66E1BC]/30 dark:border-[#1A3830] shadow-sm relative overflow-hidden">
        <div class="text-2xl sm:text-3xl font-extrabold text-[#E5F6F1] dark:text-[#1A3830] absolute top-2 right-3">02</div>
        <div class="relative z-10">
          <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded bg-[#E5F6F1] dark:bg-[#03684A]/60 text-[#03684A] dark:text-[#E5F6F1] mb-1.5">
            Phase 2
          </span>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-1">{t.step2Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.step2Desc}</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div id="step-3" class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#10221D] border border-[#66E1BC]/30 dark:border-[#1A3830] shadow-sm relative overflow-hidden">
        <div class="text-2xl sm:text-3xl font-extrabold text-[#E5F6F1] dark:text-[#1A3830] absolute top-2 right-3">03</div>
        <div class="relative z-10">
          <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded bg-[#E5F6F1] dark:bg-[#03684A]/60 text-[#03684A] dark:text-[#E5F6F1] mb-1.5">
            Phase 3
          </span>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-1">{t.step3Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.step3Desc}</p>
        </div>
      </div>

      <!-- Step 4 -->
      <div id="step-4" class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#10221D] border border-[#66E1BC]/30 dark:border-[#1A3830] shadow-sm relative overflow-hidden">
        <div class="text-2xl sm:text-3xl font-extrabold text-[#E5F6F1] dark:text-[#1A3830] absolute top-2 right-3">04</div>
        <div class="relative z-10">
          <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded bg-[#E5F6F1] dark:bg-[#03684A]/60 text-[#03684A] dark:text-[#E5F6F1] mb-1.5">
            Phase 4
          </span>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-1">{t.step4Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.step4Desc}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Proven Benefits Grid -->
  <div id="benefits">
    <h3 class="text-lg sm:text-2xl font-bold text-center text-[#03684A] dark:text-white mb-5 sm:mb-8">
      {t.benefitsHeading}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-5">
      <!-- Benefit 1 -->
      <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl glass-panel border border-[#66E1BC]/30 dark:border-[#1A3830]">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#15D59C] flex-shrink-0 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-0.5 sm:mb-1">{t.b1Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.b1Desc}</p>
        </div>
      </div>

      <!-- Benefit 2 -->
      <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl glass-panel border border-[#66E1BC]/30 dark:border-[#1A3830]">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#15D59C] flex-shrink-0 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-0.5 sm:mb-1">{t.b2Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.b2Desc}</p>
        </div>
      </div>

      <!-- Benefit 3 -->
      <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl glass-panel border border-[#66E1BC]/30 dark:border-[#1A3830]">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#15D59C] flex-shrink-0 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-0.5 sm:mb-1">{t.b3Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.b3Desc}</p>
        </div>
      </div>

      <!-- Benefit 4 -->
      <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl glass-panel border border-[#66E1BC]/30 dark:border-[#1A3830]">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#E5F6F1] dark:bg-[#10221D] text-[#03684A] dark:text-[#15D59C] flex-shrink-0 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-sm sm:text-base text-slate-800 dark:text-white mb-0.5 sm:mb-1">{t.b4Title}</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{t.b4Desc}</p>
        </div>
      </div>
    </div>
  </div>
</section>
