---
import type { TranslationKey } from '../i18n';

interface Props {
  t: TranslationKey['footer'];
}

const { t } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#E5F6F1] dark:border-[#1A3830] bg-white/60 dark:bg-[#091512]/60 mt-10 sm:mt-16 py-8 sm:py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 flex flex-col items-center text-center">
    <!-- Serene Quote -->
    <p class="text-xs sm:text-sm italic font-serif text-slate-500 dark:text-slate-400 mb-3 sm:mb-4 max-w-md">
      "{t.quote}"
    </p>

    <!-- Privacy & Offline Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E5F6F1] dark:bg-[#10221D] text-[10px] sm:text-xs text-[#03684A] dark:text-[#66E1BC] font-semibold border border-[#66E1BC]/30 dark:border-[#1A3830] mb-4 sm:mb-6">
      <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#15D59C]"></span>
      <span>{t.privacy}</span>
    </div>

    <!-- Links: Buy Me A Coffee & GitHub -->
    <div class="flex items-center gap-5 sm:gap-6 text-xs sm:text-sm font-medium mb-4 sm:mb-6">
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition-colors"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
          <path d="M20 3H4a2 2 0 00-2 2v10a4 4 0 004 4h8a4 4 0 004-4v-1h2a3 3 0 003-3V6a3 3 0 00-3-3zm-2 7h-2V5h2a1 1 0 011 1v3a1 1 0 01-1 1zm-3 8a2 2 0 01-2 2H6a2 2 0 01-2-2v-1h11v1zM4 19h16v2H4z" />
        </svg>
        <span>{t.support}</span>
      </a>

      <span class="text-slate-300 dark:text-slate-700">·</span>

      <a
        href="https://github.com/box-breathe/box-breathe.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-slate-500 hover:text-[#03684A] dark:text-slate-400 dark:hover:text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    <!-- Copyright & Disclaimer -->
    <p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500">
      &copy; {currentYear} BoxBreathe. {t.builtBy}
    </p>
  </div>
</footer>
