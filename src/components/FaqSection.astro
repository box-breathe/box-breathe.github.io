---
import type { TranslationKey } from '../i18n';

interface Props {
  t: TranslationKey['faq'];
}

const { t } = Astro.props;
---

<section class="w-full max-w-4xl mx-auto px-3 sm:px-6 py-8 sm:py-16">
  <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-10">
    <h2 class="text-xl sm:text-3xl font-bold tracking-tight text-[#03684A] dark:text-white">
      {t.heading}
    </h2>
    <p class="mt-2 text-xs sm:text-base text-slate-600 dark:text-slate-300">
      {t.subtitle}
    </p>
  </div>

  <div class="space-y-2.5 sm:space-y-3.5 max-w-3xl mx-auto">
    {t.items.map((item) => (
      <details
        class="group rounded-2xl glass-panel border border-[#66E1BC]/30 dark:border-[#1A3830] p-3.5 sm:p-5 transition-all duration-200 hover:border-[#15D59C]/60 dark:hover:border-[#15D59C]/40 open:bg-white/95 dark:open:bg-[#10221D]/90"
      >
        <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-slate-800 dark:text-slate-100 text-xs sm:text-base select-none">
          <span class="pr-3 text-left">{item.q}</span>
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#E5F6F1] dark:bg-[#1A3830] flex items-center justify-center text-[#03684A] dark:text-[#66E1BC] group-open:rotate-180 transition-transform duration-200">
            <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-2.5 sm:mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-[#E5F6F1] dark:border-[#1A3830] pt-2.5 sm:pt-3">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
