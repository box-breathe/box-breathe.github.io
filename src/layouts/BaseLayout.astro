---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SUPPORTED_LANGUAGES, type LanguageCode } from '../i18n/languages';
import { getTranslations, getLocalizedPath } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const siteUrl = 'https://box-breathe.github.io';
const canonicalUrl = `${siteUrl}${getLocalizedPath(lang, '/')}`;

// Locale mapping for OpenGraph
const localeMap: Record<LanguageCode, string> = {
  en: 'en_US',
  es: 'es_ES',
  pt: 'pt_BR',
  de: 'de_DE',
  fr: 'fr_FR',
  ja: 'ja_JP',
  zh: 'zh_CN',
};

const currentLocale = localeMap[lang] || 'en_US';
const alternateLocales = Object.entries(localeMap)
  .filter(([code]) => code !== lang)
  .map(([, loc]) => loc);

// 1. Structured Data: WebSite Schema
const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BoxBreathe',
  alternateName: ['Box Breathe', 'Square Breathing Online', 'Box Breathing Tool'],
  url: siteUrl,
  description: t.meta.description,
  inLanguage: ['en', 'es', 'pt', 'de', 'fr', 'ja', 'zh'],
};

// 2. Structured Data: WebApplication Schema
const jsonLdWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'BoxBreathe',
  url: canonicalUrl,
  description: t.meta.description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5 Web Audio API.',
  softwareVersion: '1.0.0',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  screenshot: `${siteUrl}/og-image.png`,
  creator: {
    '@type': 'Organization',
    name: 'BoxBreathe',
    url: siteUrl,
  },
  featureList: [
    '4-4-4-4 Box Breathing Visualizer & Pacer',
    'Real-time Synthesized Web Audio Singing Bowl Chimes (Zero downloads)',
    'Adjustable Pacing Intervals (3s Beginner, 4s Navy SEAL, 5s Deep Calm, 6s Advanced)',
    '100% Client-Side Private Session Tracker & LocalStorage Mindful Minutes',
    'Zero Tracking Cookies, Zero Remote Telemetry, 100% Offline Capable',
  ],
};

// 3. Structured Data: HowTo Schema (4-4-4-4 Square Breathing)
const jsonLdHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.guide.stepsHeading,
  description: t.guide.subtitle,
  totalTime: 'PT5M',
  supply: [
    {
      '@type': 'HowToSupply',
      name: 'Quiet, comfortable seating position',
    },
  ],
  tool: [
    {
      '@type': 'HowToTool',
      name: 'BoxBreathe Online Interactive Pacer',
    },
  ],
  step: [
    {
      '@type': 'HowToStep',
      name: t.guide.step1Title,
      text: t.guide.step1Desc,
      position: 1,
      url: `${canonicalUrl}#step-1`,
    },
    {
      '@type': 'HowToStep',
      name: t.guide.step2Title,
      text: t.guide.step2Desc,
      position: 2,
      url: `${canonicalUrl}#step-2`,
    },
    {
      '@type': 'HowToStep',
      name: t.guide.step3Title,
      text: t.guide.step3Desc,
      position: 3,
      url: `${canonicalUrl}#step-3`,
    },
    {
      '@type': 'HowToStep',
      name: t.guide.step4Title,
      text: t.guide.step4Desc,
      position: 4,
      url: `${canonicalUrl}#step-4`,
    },
  ],
};

// 4. Structured Data: BreadcrumbList Schema
const jsonLdBreadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.logo,
      item: canonicalUrl,
    },
  ],
};

// 5. Structured Data: FAQPage Schema
const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Performance Preconnections -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GXKD5Z4PKN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GXKD5Z4PKN');
    </script>

    <!-- Technical SEO Metadata -->
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="keywords" content={t.meta.keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="BoxBreathe" />
    <meta name="theme-color" content="#03684A" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="rating" content="general" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Apple Web App Metas -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="BoxBreathe" />

    <!-- Open Graph (Facebook, LinkedIn, Discord) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BoxBreathe 4-4-4-4 Box Breathing & Focus Tool" />
    <meta property="og:site_name" content="BoxBreathe" />
    <meta property="og:locale" content={currentLocale} />
    {alternateLocales.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content="BoxBreathe 4-4-4-4 Box Breathing & Focus Tool" />

    <!-- Hreflang Canonical Tags for all 7 Locales -->
    {SUPPORTED_LANGUAGES.map((l) => (
      <link
        rel="alternate"
        hreflang={l.code}
        href={`${siteUrl}${getLocalizedPath(l.code, '/')}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Immediate Anti-FOUC Theme Script -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const isDark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Schema.org 5-Pillar JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdHowTo)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </head>
  <body class="min-h-screen flex flex-col bg-calm-lightBg dark:bg-calm-darkBg transition-colors duration-300">
    <Navbar currentLang={lang} t={t.nav} />

    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <Footer t={t.footer} />
  </body>
</html>
